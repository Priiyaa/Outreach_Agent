# Copy to backend/.env for local use. All optional: with nothing set the app uses the local SQLite file.

# Hosted Postgres (leave unset to use SQLite). Needs the psycopg2 driver prefix and TLS on most hosts.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname?sslmode=require

# Lock editing behind a shared access code (reads stay open). Unset = anyone can edit.
# WRITE_TOKEN=choose-a-long-random-string

# JSON list of browser origins allowed to call the API.
# CORS_ORIGINS=["http://localhost:3100","https://your-app.vercel.app"]

# Hide the in-app fetch button (hosts that sleep; a schedule does the fetching instead).
# ALLOW_FETCH=false

# Optional extras
# GEMINI_API_KEY=...       # LLM classifier stage (also set llm.provider: gemini in config/config.yaml)
